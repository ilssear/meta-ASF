{
    "version": "1.0.0",
    "environment": {
        "name": "development",
        "debug": true,
        "log_level": "DEBUG"
    },
    "application": {
        "name": "project_name",
        "description": "Project description",
        "version": "1.0.0",
        "author": "Your Name",
        "license": "MIT"
    },
    "server": {
        "host": "localhost",
        "port": 8000,
        "timeout": 30,
        "max_connections": 100
    },
    "database": {
        "type": "postgresql",
        "host": "localhost",
        "port": 5432,
        "name": "db_name",
        "user": "db_user",
        "password": "db_password",
        "pool_size": 5,
        "timeout": 30
    },
    "security": {
        "secret_key": "your-secret-key",
        "token_expiry": 3600,
        "allowed_hosts": ["localhost", "127.0.0.1"],
        "cors_origins": ["http://localhost:3000"]
    },
    "logging": {
        "level": "DEBUG",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "app.log",
        "max_size": 10485760,
        "backup_count": 5
    },
    "monitoring": {
        "enabled": true,
        "metrics_port": 9090,
        "health_check_interval": 30
    },
    "cache": {
        "type": "redis",
        "host": "localhost",
        "port": 6379,
        "db": 0,
        "ttl": 3600
    },
    "email": {
        "smtp_host": "smtp.gmail.com",
        "smtp_port": 587,
        "username": "your-email@gmail.com",
        "password": "your-app-password",
        "from_address": "your-email@gmail.com"
    },
    "storage": {
        "type": "local",
        "path": "./storage",
        "max_file_size": 10485760,
        "allowed_types": ["image/jpeg", "image/png", "application/pdf"]
    },
    "api": {
        "version": "v1",
        "prefix": "/api/v1",
        "rate_limit": 100,
        "timeout": 30
    },
    "testing": {
        "test_database": "test_db",
        "coverage_threshold": 80,
        "timeout": 30
    }
} 
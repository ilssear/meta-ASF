{
    "version": "1.0.0",
    "project": {
        "name": "Agile SpecFirst for Cursor",
        "description": "Project description",
        "author": "Jaime Moraga (jmoraga@mines.edu)",
        "year": "2025"
    },
    "environment": {
        "development": {
            "debug": true,
            "log_level": "DEBUG",
            "api_url": "http://localhost:8000",
            "database": {
                "host": "localhost",
                "port": 5432,
                "name": "dev_db",
                "user": "dev_user",
                "password": "dev_password"
            }
        },
        "testing": {
            "debug": true,
            "log_level": "DEBUG",
            "api_url": "http://localhost:8000",
            "database": {
                "host": "localhost",
                "port": 5432,
                "name": "test_db",
                "user": "test_user",
                "password": "test_password"
            }
        },
        "production": {
            "debug": false,
            "log_level": "INFO",
            "api_url": "https://api.example.com",
            "database": {
                "host": "db.example.com",
                "port": 5432,
                "name": "prod_db",
                "user": "prod_user",
                "password": "prod_password"
            }
        }
    },
    "security": {
        "jwt": {
            "secret_key": "your-secret-key",
            "algorithm": "HS256",
            "access_token_expire_minutes": 30,
            "refresh_token_expire_days": 7
        },
        "cors": {
            "allowed_origins": ["http://localhost:3000"],
            "allowed_methods": ["GET", "POST", "PUT", "DELETE"],
            "allowed_headers": ["*"]
        }
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "handlers": {
            "console": {
                "enabled": true,
                "level": "INFO"
            },
            "file": {
                "enabled": true,
                "level": "DEBUG",
                "path": "logs/app.log",
                "max_size": 10485760,
                "backup_count": 5
            }
        }
    },
    "api": {
        "version": "v1",
        "prefix": "/api",
        "rate_limit": {
            "enabled": true,
            "requests_per_minute": 60
        },
        "swagger": {
            "enabled": true,
            "path": "/docs"
        }
    },
    "cache": {
        "enabled": true,
        "type": "redis",
        "host": "localhost",
        "port": 6379,
        "ttl": 3600
    },
    "monitoring": {
        "enabled": true,
        "metrics": {
            "enabled": true,
            "path": "/metrics"
        },
        "health": {
            "enabled": true,
            "path": "/health"
        }
    }
} 